root = true

# 全局默认：UTF-8、LF、文件末尾留空行、2 空格缩进
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown 的空格有时用于强制换行，保留行尾空白
[*.md]
trim_trailing_whitespace = false

# Rust 使用 4 空格缩进
[*.rs]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
