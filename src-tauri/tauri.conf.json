{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coffee-list",
  "version": "0.1.0",
  "identifier": "com.bakaqr.coffee-list",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3010",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coffee List",
        "width": 850,
        "height": 600,
        "minWidth": 850,
        "minHeight": 600,
        "maximizable": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "BakaQR",
    "active": true,
    "targets": "nsis",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
